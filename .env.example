# 1. Base URL & Site Identity
NEXT_PUBLIC_SITE_URL=https://acrepairservice.com

# 2. Hostinger MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_acuser
DB_PASSWORD=YourStrongDatabasePassword123!
