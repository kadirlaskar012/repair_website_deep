# ============================================================
# APPLIANCE SEVA - PRODUCTION ENVIRONMENT CONFIGURATION
# Domain: https://applianceseva.com
# ============================================================

# 1. Base URL & Site Identity
NEXT_PUBLIC_SITE_URL=https://applianceseva.com

# 2. Database Credentials for Vercel / Remote Hosting
# OPTION A: Single Connection String (e.g., TiDB Cloud Free Serverless, Aiven MySQL, PlanetScale)
# DATABASE_URL=mysql://2Gv...root:pass@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/applianceseva?ssl={"minVersion":"TLSv1.2"}

# OPTION B: Separate Environment Variables (e.g., cPanel / Hostinger Remote MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_applianceuser
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=u123456789_applianceseva
DB_SSL=false

# 3. Super Admin Authentication & Security
ADMIN_PHONE=6291674186
ADMIN_EMAIL=admin@applianceseva.com
ADMIN_PASSWORD=6291674186
JWT_SECRET=appliance-seva-jwt-super-secret-key-2026-production

# 4. Nodemailer SMTP (For Booking Leads Dispatch to Business Email)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=service@applianceseva.com
SMTP_PASS=YourEmailPassword123!
SMTP_FROM="Appliance Seva" <service@applianceseva.com>
BUSINESS_EMAIL=service@applianceseva.com

# 5. AI Providers for Blog Draft Generation (Optional / Configurable via Admin)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
